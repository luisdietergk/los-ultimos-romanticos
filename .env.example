# Copy this file to .env and fill in real values.
# On Vercel, set these in Project Settings → Environment Variables instead
# of committing a .env file.

# Postgres connection string (e.g. from Neon). Same variable for local dev
# and production — a free Neon project works fine for either.
DATABASE_URL=""

# Auth.js — generate a real random secret, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Used once by prisma/seed.ts to create the first AdminUser (safe to leave
# set — re-running the seed after the first successful run is a no-op).
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Vercel Blob — set automatically once you attach a Blob store to the
# Vercel project (Storage tab → Create → Blob → Connect to project). Leave
# unset for local dev: uploads fall back to writing into public/uploads/.
BLOB_READ_WRITE_TOKEN=""

# Public links — the footer/shop WhatsApp and Instagram buttons stay hidden
# until these are set.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_INSTAGRAM_URL=""
